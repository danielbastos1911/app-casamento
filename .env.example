# Banco de dados (Postgres local via docker-compose)
DATABASE_URL="postgresql://casamento:casamento@localhost:5432/casamento?schema=public"

# Autenticação admin (usado para assinar o cookie de sessão)
AUTH_SECRET="troque-por-um-valor-aleatorio-longo"

# Usuário admin inicial (usado pelo prisma/seed.ts)
ADMIN_EMAIL="noivos@example.com"
ADMIN_PASSWORD="troque-esta-senha"

# AWS S3 (upload de imagens)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# URL pública do app (usada para montar os links de retorno/webhook do Mercado Pago)
APP_URL="http://localhost:3000"

# Mercado Pago (use um Access Token de TESTE — começa com "TEST-" — durante o desenvolvimento)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
